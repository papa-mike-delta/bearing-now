# Environment Variables

# Database (PostgreSQL)
# Local example: create a database named life_os in your local PostgreSQL server.
# Vercel example: use your Neon PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/life_os

# Session secret (change this in production!)
# Production requires a unique random secret of at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# In-app Coach tool invoker (off unless explicitly set to true)
COACH_TOOLS_ENABLED=false

# Optional: AI provider (leave empty to use built-in Z.AI SDK)
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Opt in only after reviewing/applying the separate V1 schema on a disposable preview.
# See docs/redesign/DATA_FOUNDATIONS.md. Legacy deploy does not apply V1 migrations.
BEARING_V1_ENABLED=false

# V1 conversational Coach (server only). Both provider and model must be configured.
BEARING_COACH_PROVIDER=openrouter
BEARING_COACH_MODEL=
OPENROUTER_API_KEY=
# For BEARING_COACH_PROVIDER=gateway:
AI_GATEWAY_API_KEY=
# Optional trusted server proxy for OpenRouter, e.g. a local deterministic test server.
# BEARING_COACH_OPENROUTER_URL=https://openrouter.ai/api/v1
