{
  "name": "bearing-now",
  "version": "0.2.0",
  "description": "Capture, organize, connect and recall personal information with Daily Journal, connected Items and approval-gated Coach.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "bearing-now",
    "digital-brain",
    "second-brain",
    "personal-knowledge-management",
    "productivity",
    "self-hosted",
    "habit-tracker",
    "open-source-habit-tracker",
    "daily-habit-tracker",
    "journal",
    "journal-app",
    "task-manager",
    "focus-timer",
    "pomodoro",
    "knowledge-graph",
    "personal-dashboard",
    "nextjs",
    "prisma",
    "pwa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/papa-mike-delta/bearing-now.git"
  },
  "bugs": {
    "url": "https://github.com/papa-mike-delta/bearing-now/issues"
  },
  "homepage": "https://github.com/papa-mike-delta/bearing-now#readme",
  "scripts": {
    "dev": "next dev -p 3000",
    "postinstall": "npm run db:generate",
    "build": "node scripts/prepare-offline.mjs && npm run db:generate && next build",
    "build:vercel": "node scripts/prepare-offline.mjs && npm run db:generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "theme:generate": "tsx scripts/generate-theme.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate && prisma generate --schema prisma/v1/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:v1:deploy": "node --import tsx scripts/deploy-v1.ts",
    "test:v1": "vitest run --config vitest.v1.config.mts",
    "test:e2e:coach": "playwright test --config e2e/v1-coach.config.ts",
    "test:e2e:release": "playwright test --config e2e/v1-release.config.ts",
    "db:invite": "node --import tsx scripts/create-invitation.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@mdxeditor/editor": "^3.39.1",
    "@prisma/client": "6.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@tanstack/react-query": "^5.82.0",
    "ai": "^7.0.153",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.31",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "fake-indexeddb": "^6.2.6",
    "prisma": "6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
